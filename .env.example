# Example environment configuration for the Constitution RAG project
# Local Ollama generation; no paid API key is needed.
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=BAAI/bge-m3
# Optional torch device override (cpu, cuda, mps). Leave empty for auto.
# On Apple Silicon, bge-m3 can exceed MPS memory: use RAG_DEVICE=cpu.
RAG_DEVICE=cpu
EMBEDDINGS_PATH=Data/processed/constitution_embeddings.jsonl
CORPUS_PATH=Data/processed
INDEX_PATH=artifacts
# Comma-separated list of allowed browser origins for the chat UI
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Low-memory mode; set true to also load dense and hybrid retrievers.
RETRIEVAL_MODE=bm25
BUILD_ALL_RETRIEVAL_MODES=false
TOP_K=5
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=1.0
HYBRID_BM25_WEIGHT=1.0
RERANKER_ENABLED=false
# Separate thresholds are required because retrieval modes use different score scales.
# These are scale-aware starting points, not calibrated correctness probabilities.
EVIDENCE_THRESHOLD=0.6
DENSE_EVIDENCE_THRESHOLD=0.58
BM25_EVIDENCE_THRESHOLD=1.0
HYBRID_EVIDENCE_THRESHOLD=0.01
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
