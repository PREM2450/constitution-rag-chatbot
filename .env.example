# Example environment configuration for the Constitution RAG project
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-with-your-key
EMBEDDING_MODEL=BAAI/bge-m3
# Optional torch device override (cpu, cuda, mps). Leave empty for auto.
# On Apple Silicon, bge-m3 can exceed MPS memory: use RAG_DEVICE=cpu.
RAG_DEVICE=cpu
EMBEDDINGS_PATH=Data/processed/constitution_embeddings.jsonl
CORPUS_PATH=Data/processed
INDEX_PATH=artifacts
# Comma-separated list of allowed browser origins for the chat UI
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_MODE=dense
TOP_K=5
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=1.0
HYBRID_BM25_WEIGHT=1.0
RERANKER_ENABLED=false
# Single scalar threshold applied to the top-1 score of whichever mode served
# the request. It is only meaningful on the dense (cosine) scale: BM25 scores
# are unbounded and hybrid RRF scores are <= ~0.033, so this value cannot
# abstain correctly for those modes. Calibrated dev values from run
# 20261119_040644 (see experiments/results/20261119_040644/final_report.md):
#   dense 0.5576 | bm25 24.7565 | hybrid 0.0321
# Per-mode thresholds are not wired into the config yet.
EVIDENCE_THRESHOLD=0.6
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
