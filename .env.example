# Example environment configuration for the Constitution RAG project
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=replace-with-your-key
EMBEDDING_MODEL=BAAI/bge-m3
# Optional torch device override (cpu, cuda, mps). Leave empty for auto.
# On Apple Silicon, bge-m3 can exceed MPS memory: use RAG_DEVICE=cpu.
RAG_DEVICE=cpu
EMBEDDINGS_PATH=Data/processed/constitution_embeddings.jsonl
CORPUS_PATH=Data/processed
INDEX_PATH=artifacts
# Comma-separated list of allowed browser origins for the chat UI
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_MODE=dense
TOP_K=5
HYBRID_FUSION=rrf
RERANKER_ENABLED=false
EVIDENCE_THRESHOLD=0.6
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
